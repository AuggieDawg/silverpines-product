# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

# Prisma connection string.
# - Do NOT commit this file to GitHub.
# - Use .env.example to document required variables without secrets.
DATABASE_URL="postgresql://neondb_owner:royal-butterfly-akfyczgd-pooler.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:royal-butterfly-akfyczgd.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require"
ML_SERVICE_URL="http://localhost:8001"

AUTHORIZED_EMAILS=agustin03036944@gmail.com
PRIVATE_DEMO_MODE=true

# Auth.js (NextAuth) uses this to generate correct redirect URLs.
# In production this becomes your real domain (e.g., https://yourdomain.com).
NEXTAUTH_URL="http://localhost:3000"

# This secret is used to sign/encrypt auth-related tokens.
# Generate with: openssl rand -base64 32
# If you rotate it, all sessions become invalid (users will need to sign in again).
NEXTAUTH_SECRET=NEXT_AUTH_SECRET

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
