generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma v7 + prisma.config.ts:
  // The connection URL is configured in prisma.config.ts, not here.
}

enum TaskScope {
  PORTAL
  OWNER
}

enum Role {
  USER
  ADMIN
}

enum WorkbenchTaskStatus {
  Open
  InProgress
  Review
  Completed
  Overdue
}

enum WorkbenchTaskPriority {
  Low
  Medium
  High
}


enum RepairDeviceType {
  Phone
  Tablet
  Laptop
  Desktop
  AllInOne
  CustomBuild
  Monitor
  GameConsole
  Smartwatch
  Printer
  Other
}

enum RepairTicketPriority {
  Low
  Medium
  High
  Urgent
}

enum RepairIntakeChannel {
  WalkIn
  Phone
  Text
  WhatsApp
  Facebook
  Website
  Referral
  Other
}

enum RepairQuoteStatus {
  Draft
  Sent
  Approved
  Rejected
  Expired
}

enum RepairPhotoCategory {
  Intake
  Before
  Damage
  Diagnostic
  Progress
  After
  Receipt
  Pickup
  Other
}

enum RepairPaymentMethod {
  Cash
  Card
  Transfer
  Zelle
  CashApp
  Other
}

enum InvoiceStatus {
  Draft
  Open
  Paid
  Overdue
  Void
}

enum DocumentCategory {
  Operations
  Support
  Commercial
  Warranty
  Other
}

enum ManagedUnitStatus {
  Occupied
  Vacant
  Notice
  Turn
  Down
  Model
}

enum GarageIndicator {
  Y
  N
}

enum UnitAccessType {
  ApartmentDoor
  GarageDoor
  Mailbox
  Gate
  Storage
  Utility
  Other
}

enum RepairStatus {
  Reported
  Approved
  Scheduled
  InProgress
  WaitingOnParts
  Completed
  Closed
  Cancelled
}

enum MaintenanceStatus {
  Upcoming
  DueSoon
  Overdue
  Completed
  Skipped
  Cancelled
}

enum MaintenanceFrequency {
  Weekly
  Monthly
  Quarterly
  SemiAnnual
  Annual
  Custom
}

enum ManagedDocumentCategory {
  Lease
  Inspection
  Invoice
  Receipt
  Warranty
  Photo
  Spreadsheet
  Maintenance
  Repair
  Access
  Floorplan
  Other
}

enum ManagedPhotoCategory {
  General
  Inspection
  Before
  After
  Damage
  Turnover
  Appliance
  Exterior
  Safety
  Receipt
  Other
}

enum ManagedPhotoSubjectType {
  Property
  Unit
  Garage
  Repair
  Maintenance
}

enum ManagedPhotoRoomTag {
  Unknown
  Exterior
  Entry
  LivingRoom
  Kitchen
  DiningRoom
  Hallway
  Bathroom
  Bedroom
  Laundry
  Utility
  Garage
  Balcony
  Patio
  Closet
  Mechanical
  Other
}

enum InspectionSetStatus {
  Open
  InReview
  Closed
}

model User {
  id                         String                 @id @default(cuid())
  email                      String                 @unique
  emailVerified              DateTime?
  name                       String?
  image                      String?
  role                       Role                   @default(USER)
  profile                    Profile?
  tasks                      Task[]
  accounts                   Account[]
  sessions                   Session[]
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  workbenchTasks             WorkbenchTask[]        @relation("WorkbenchTaskOwner")
  workbenchTaskComments      WorkbenchTaskComment[] @relation("WorkbenchTaskCommentAuthor")
  workbenchTaskLinks         WorkbenchTaskLink[]    @relation("WorkbenchTaskLinkOwner")
  mapBoxes                   MapBox[]               @relation("UserMapBoxes")

  repairCustomersOwned       RepairCustomer[]       @relation("RepairCustomerOwner")
  repairDevicesOwned         RepairDevice[]         @relation("RepairDeviceOwner")
  repairTicketsOwned         RepairTicket[]         @relation("RepairTicketOwner")
  repairInventoryPartsOwned  InventoryPart[]        @relation("InventoryPartOwner")
  repairInvoicesOwned        RepairInvoice[]        @relation("RepairInvoiceOwner")
  repairDocumentsOwned       RepairDocument[]       @relation("RepairDocumentOwner")
  repairPhotosUploaded       RepairPhoto[]          @relation("RepairPhotoUploadedBy")
  repairNotesAuthored        RepairNote[]           @relation("RepairNoteAuthor")
  repairAuditLogsAsActor     RepairAuditLog[]       @relation("RepairAuditLogActor")

  managedPropertiesOwned     ManagedProperty[]      @relation("ManagedPropertyOwner")
  managedPropertyMemberships ManagedPropertyMember[]
  managedAuditLogsAsActor    ManagedAuditLog[]      @relation("ManagedAuditLogActor")
  managedPhotosUploaded      ManagedPhoto[]         @relation("ManagedPhotoUploadedBy")
  inspectionSetsCreated      InspectionSet[]        @relation("InspectionSetCreatedBy")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean   @default(false)
  status    String    @default("todo")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  scope     TaskScope @default(PORTAL)

  @@index([userId])
  @@index([userId, scope])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WorkbenchTask {
  id            String                 @id @default(cuid())
  title         String
  client        String
  dueDate       DateTime?
  assignee      String
  status        WorkbenchTaskStatus    @default(Open)
  priority      WorkbenchTaskPriority  @default(Medium)
  mapX          Float                  @default(40)
  mapY          Float                  @default(40)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  ownerId       String?
  owner         User?                  @relation("WorkbenchTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  comments      WorkbenchTaskComment[]
  outgoingLinks WorkbenchTaskLink[]    @relation("WorkbenchTaskLinkSource")
  incomingLinks WorkbenchTaskLink[]    @relation("WorkbenchTaskLinkTarget")

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([ownerId, updatedAt])
}

model WorkbenchTaskLink {
  id           String        @id @default(cuid())
  ownerId      String
  sourceTaskId String
  targetTaskId String
  createdAt    DateTime      @default(now())
  owner        User          @relation("WorkbenchTaskLinkOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sourceTask   WorkbenchTask @relation("WorkbenchTaskLinkSource", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask   WorkbenchTask @relation("WorkbenchTaskLinkTarget", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@unique([ownerId, sourceTaskId, targetTaskId])
  @@index([ownerId])
  @@index([sourceTaskId])
  @@index([targetTaskId])
}

model WorkbenchTaskComment {
  id        String        @id @default(cuid())
  body      String
  createdAt DateTime      @default(now())
  taskId    String
  task      WorkbenchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation("WorkbenchTaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model MapBox {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserMapBoxes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, order])
}


model RepairCustomer {
  id           String           @id @default(cuid())
  ownerId      String
  displayName  String
  companyName  String?
  phone        String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?          @default("US")
  notes        String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  owner        User             @relation("RepairCustomerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  devices      RepairDevice[]
  tickets      RepairTicket[]
  invoices     RepairInvoice[]
  documents    RepairDocument[]
  auditLogs    RepairAuditLog[]

  @@index([ownerId])
  @@index([ownerId, displayName])
  @@index([phone])
  @@index([email])
}

model RepairDevice {
  id                    String           @id @default(cuid())
  ownerId               String
  customerId            String
  label                 String
  deviceType            RepairDeviceType
  brand                 String?
  model                 String?
  color                 String?
  serialNumber          String?
  imei                  String?
  storageCapacity       String?
  operatingSystem       String?
  passcodeHint          String?
  accessoriesIncluded   String?
  issueSummary          String?
  cosmeticCondition     String?
  powersOn              Boolean?
  liquidDamageSuspected Boolean          @default(false)
  dataBackupRequested   Boolean          @default(false)
  dataPrivacyAccepted   Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  owner                 User             @relation("RepairDeviceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  customer              RepairCustomer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tickets               RepairTicket[]
  photos                RepairPhoto[]

  @@index([ownerId])
  @@index([customerId])
  @@index([deviceType])
  @@index([serialNumber])
  @@index([imei])
}

model RepairTicket {
  id                 String               @id @default(cuid())
  ownerId            String
  customerId         String
  deviceId           String
  ticketNumber       String               @unique
  title              String
  status             RepairStatus         @default(Reported)
  priority           RepairTicketPriority @default(Medium)
  intakeChannel      RepairIntakeChannel  @default(WalkIn)
  reportedIssue      String?
  diagnosticSummary  String?
  internalNotes      String?
  claimCheckCode     String?
  quotedAmount       Decimal?             @db.Decimal(10, 2)
  estimatedPartsCost Decimal?             @db.Decimal(10, 2)
  estimatedLaborCost Decimal?             @db.Decimal(10, 2)
  finalAmount        Decimal?             @db.Decimal(10, 2)
  depositAmount      Decimal?             @db.Decimal(10, 2)
  receivedAt         DateTime             @default(now())
  scheduledFor       DateTime?
  startedAt          DateTime?
  approvedAt         DateTime?
  completedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  owner              User                 @relation("RepairTicketOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  customer           RepairCustomer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  device             RepairDevice         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  notes              RepairNote[]
  photos             RepairPhoto[]
  partUsages         RepairPartUsage[]
  quotes             RepairQuote[]
  invoices           RepairInvoice[]
  documents          RepairDocument[]
  auditLogs          RepairAuditLog[]

  @@index([ownerId])
  @@index([customerId, receivedAt])
  @@index([deviceId, receivedAt])
  @@index([status, updatedAt])
  @@index([priority, updatedAt])
}

model RepairNote {
  id                String       @id @default(cuid())
  ticketId          String
  authorUserId      String?
  body              String
  isCustomerVisible Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  ticket            RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser        User?        @relation("RepairNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([authorUserId, createdAt])
}

model InventoryPart {
  id             String          @id @default(cuid())
  ownerId        String
  sku            String?
  name           String
  brand          String?
  category       String?
  compatibleWith String?
  supplierName   String?
  supplierUrl    String?
  quantityOnHand Int             @default(0)
  reorderPoint   Int?
  unitCost       Decimal?        @db.Decimal(10, 2)
  unitPrice      Decimal?        @db.Decimal(10, 2)
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  owner          User            @relation("InventoryPartOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  usages         RepairPartUsage[]

  @@index([ownerId])
  @@index([ownerId, name])
  @@index([sku])
  @@index([quantityOnHand])
}

model RepairPartUsage {
  id        String       @id @default(cuid())
  ticketId  String
  partId    String
  quantity  Int          @default(1)
  unitCost  Decimal?     @db.Decimal(10, 2)
  unitPrice Decimal?     @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  ticket    RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  part      InventoryPart @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([partId])
}

model RepairQuote {
  id          String            @id @default(cuid())
  ticketId    String
  status      RepairQuoteStatus @default(Draft)
  laborAmount Decimal?          @db.Decimal(10, 2)
  partsAmount Decimal?          @db.Decimal(10, 2)
  taxAmount   Decimal?          @db.Decimal(10, 2)
  totalAmount Decimal?          @db.Decimal(10, 2)
  notes       String?
  sentAt      DateTime?
  respondedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  ticket      RepairTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([status])
}

model RepairInvoice {
  id            String               @id @default(cuid())
  ownerId       String
  customerId    String
  ticketId      String?
  invoiceNumber String               @unique
  status        InvoiceStatus        @default(Draft)
  paymentMethod RepairPaymentMethod?
  subtotal      Decimal?             @db.Decimal(10, 2)
  taxAmount     Decimal?             @db.Decimal(10, 2)
  totalAmount   Decimal?             @db.Decimal(10, 2)
  amountPaid    Decimal?             @db.Decimal(10, 2)
  issuedAt      DateTime?
  dueAt         DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  owner         User                 @relation("RepairInvoiceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  customer      RepairCustomer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticket        RepairTicket?        @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([customerId, createdAt])
  @@index([ticketId])
  @@index([status])
}

model RepairDocument {
  id               String           @id @default(cuid())
  ownerId          String
  customerId       String?
  ticketId         String?
  name             String
  originalFileName String?
  mimeType         String
  category         DocumentCategory @default(Other)
  summary          String?
  storageKey       String
  fileSizeBytes    Int?
  uploadedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  owner            User             @relation("RepairDocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  customer         RepairCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ticket           RepairTicket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([ownerId, category])
  @@index([customerId, uploadedAt])
  @@index([ticketId, uploadedAt])
}

model RepairPhoto {
  id               String              @id @default(cuid())
  ticketId         String
  deviceId         String?
  uploadedByUserId String?
  category         RepairPhotoCategory @default(Intake)
  caption          String?
  originalFileName String?
  mimeType         String
  storageKey       String
  width            Int?
  height           Int?
  fileSizeBytes    Int?
  takenAt          DateTime?
  uploadedAt       DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  ticket           RepairTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  device           RepairDevice?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  uploadedByUser   User?               @relation("RepairPhotoUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, uploadedAt])
  @@index([deviceId, uploadedAt])
  @@index([uploadedByUserId, uploadedAt])
}

model RepairAuditLog {
  id          String          @id @default(cuid())
  customerId  String?
  ticketId    String?
  actorUserId String?
  entityType  String
  entityId    String?
  action      String
  metadata    Json?
  createdAt   DateTime        @default(now())

  customer    RepairCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ticket      RepairTicket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  actorUser   User?           @relation("RepairAuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([ticketId, createdAt])
  @@index([actorUserId, createdAt])
}

model ManagedProperty {
  id                        String                      @id @default(cuid())
  ownerId                   String
  code                      String                      @unique
  name                      String
  nickname                  String?
  description               String?
  addressLine1              String?
  addressLine2              String?
  city                      String?
  state                     String?
  postalCode                String?
  country                   String?                     @default("US")
  timezone                  String?
  isActive                  Boolean                     @default(true)
  notes                     String?
  owner                     User                        @relation("ManagedPropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members                   ManagedPropertyMember[]
  units                     ManagedUnit[]
  garages                   ManagedGarage[]
  vendors                   ManagedVendor[]
  maintenancePlans          PreventiveMaintenancePlan[]
  documents                 ManagedDocument[]
  auditLogs                 ManagedAuditLog[]
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  unitRepairEvents          UnitRepairEvent[]
  preventiveMaintenanceRuns PreventiveMaintenanceRun[]
  unitAccessCodes           UnitAccessCode[]
  unitKeys                  UnitKey[]
  unitNotes                 UnitNote[]
  inspectionSets            InspectionSet[]
  photos                    ManagedPhoto[]

  @@index([ownerId])
  @@index([ownerId, updatedAt])
}

model ManagedPropertyMember {
  id         String          @id @default(cuid())
  propertyId String
  userId     String
  accessRole String          @default("Viewer")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  property   ManagedProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([userId])
  @@index([propertyId])
}

model ManagedGarage {
  id                String                     @id @default(cuid())
  propertyId        String
  garageCode        String                     @unique
  label             String?
  locationLabel     String?
  status            ManagedUnitStatus          @default(Vacant)
  notesSummary      String?
  notes             String?
  lastRepairAt      DateTime?
  lastMaintenanceAt DateTime?
  isActive          Boolean                    @default(true)
  property          ManagedProperty            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  linkedUnits       ManagedUnit[]              @relation("UnitGarageLink")
  repairs           UnitRepairEvent[]
  maintenanceRuns   PreventiveMaintenanceRun[]
  accessCodes       UnitAccessCode[]
  keys              UnitKey[]
  documents         ManagedDocument[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  inspectionSets    InspectionSet[]
  photos            ManagedPhoto[]

  @@index([propertyId])
  @@index([propertyId, garageCode])
  @@index([status])
}

model ManagedUnit {
  id                String            @id @default(cuid())
  propertyId        String
  unitCode          String            @unique
  buildingLabel     String?
  floorLabel        String?
  unitNumber        String
  bedroomCount      Int?
  bathroomCount     Decimal?          @db.Decimal(3, 1)
  squareFeet        Int?
  status            ManagedUnitStatus @default(Vacant)
  hasGarage         Boolean           @default(false)
  garageIndicator   GarageIndicator   @default(N)
  linkedGarageId    String?
  notesSummary      String?
  lastRepairAt      DateTime?
  lastMaintenanceAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  property        ManagedProperty            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  linkedGarage    ManagedGarage?             @relation("UnitGarageLink", fields: [linkedGarageId], references: [id], onDelete: SetNull)
  repairs         UnitRepairEvent[]
  maintenanceRuns PreventiveMaintenanceRun[]
  accessCodes     UnitAccessCode[]
  keys            UnitKey[]
  documents       ManagedDocument[]
  notes           UnitNote[]
  inspectionSets  InspectionSet[]
  photos          ManagedPhoto[]

  @@index([propertyId])
  @@index([propertyId, unitCode])
  @@index([propertyId, buildingLabel, unitNumber])
  @@index([linkedGarageId])
  @@index([status])
}

model ManagedVendor {
  id              String                     @id @default(cuid())
  propertyId      String
  name            String
  tradeCategory   String?
  phone           String?
  email           String?
  website         String?
  contactName     String?
  notes           String?
  isActive        Boolean                    @default(true)
  property        ManagedProperty            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  repairs         UnitRepairEvent[]
  maintenanceRuns PreventiveMaintenanceRun[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([propertyId])
  @@index([propertyId, name])
}

model UnitRepairEvent {
  id            String         @id @default(cuid())
  propertyId    String
  unitId        String?
  garageId      String?
  vendorId      String?
  title         String
  category      String
  priority      String
  status        RepairStatus   @default(Reported)
  description   String?
  openedAt      DateTime       @default(now())
  scheduledFor  DateTime?
  completedAt   DateTime?
  estimatedCost Decimal?       @db.Decimal(10, 2)
  actualCost    Decimal?       @db.Decimal(10, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  photos        ManagedPhoto[]

  property  ManagedProperty   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit      ManagedUnit?      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  garage    ManagedGarage?    @relation(fields: [garageId], references: [id], onDelete: SetNull)
  vendor    ManagedVendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  documents ManagedDocument[]

  @@index([propertyId])
  @@index([unitId, openedAt])
  @@index([garageId, openedAt])
  @@index([status])
  @@index([vendorId])
}

model PreventiveMaintenancePlan {
  id           String                     @id @default(cuid())
  propertyId   String
  title        String
  category     String
  description  String?
  frequency    MaintenanceFrequency
  intervalDays Int?
  targetScope  String                     @default("UNIT")
  isActive     Boolean                    @default(true)
  nextDueAt    DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  photos       ManagedPhoto[]
  property     ManagedProperty            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  runs         PreventiveMaintenanceRun[]

  @@index([propertyId])
  @@index([propertyId, isActive])
  @@index([nextDueAt])
}

model InspectionSet {
  id              String              @id @default(cuid())
  propertyId      String
  unitId          String?
  garageId        String?
  createdByUserId String?
  code            String              @unique
  title           String
  description     String?
  status          InspectionSetStatus @default(Open)
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  property      ManagedProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit          ManagedUnit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  garage        ManagedGarage?  @relation(fields: [garageId], references: [id], onDelete: SetNull)
  createdByUser User?           @relation("InspectionSetCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  photos        ManagedPhoto[]

  @@index([propertyId, startedAt])
  @@index([unitId, startedAt])
  @@index([garageId, startedAt])
  @@index([createdByUserId, startedAt])
  @@index([status])
}

model ManagedPhoto {
  id               String                  @id @default(cuid())
  propertyId       String
  unitId           String?
  garageId         String?
  repairEventId    String?
  maintenanceRunId String?
  inspectionSetId  String?
  uploadedByUserId String?
  category         ManagedPhotoCategory    @default(General)
  subjectType      ManagedPhotoSubjectType @default(Unit)
  roomTag          ManagedPhotoRoomTag     @default(Unknown)
  caption          String?
  originalFileName String?
  mimeType         String
  storageKey       String
  width            Int?
  height           Int?
  fileSizeBytes    Int?
  takenAt          DateTime?
  uploadedAt       DateTime                @default(now())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  property                    ManagedProperty            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit                        ManagedUnit?               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  garage                      ManagedGarage?             @relation(fields: [garageId], references: [id], onDelete: SetNull)
  repairEvent                 UnitRepairEvent?           @relation(fields: [repairEventId], references: [id], onDelete: SetNull)
  maintenanceRun              PreventiveMaintenanceRun?  @relation(fields: [maintenanceRunId], references: [id], onDelete: SetNull)
  inspectionSet               InspectionSet?             @relation(fields: [inspectionSetId], references: [id], onDelete: SetNull)
  uploadedByUser              User?                      @relation("ManagedPhotoUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  preventiveMaintenancePlan   PreventiveMaintenancePlan? @relation(fields: [preventiveMaintenancePlanId], references: [id])
  preventiveMaintenancePlanId String?

  @@index([propertyId, uploadedAt])
  @@index([unitId, uploadedAt])
  @@index([garageId, uploadedAt])
  @@index([inspectionSetId, uploadedAt])
  @@index([repairEventId, uploadedAt])
  @@index([maintenanceRunId, uploadedAt])
  @@index([uploadedByUserId, uploadedAt])
  @@index([category])
  @@index([roomTag])
}

model PreventiveMaintenanceRun {
  id            String            @id @default(cuid())
  propertyId    String
  unitId        String?
  garageId      String?
  planId        String?
  vendorId      String?
  title         String
  category      String
  status        MaintenanceStatus @default(Upcoming)
  dueAt         DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  notes         String?
  estimatedCost Decimal?          @db.Decimal(10, 2)
  actualCost    Decimal?          @db.Decimal(10, 2)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  property      ManagedProperty            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit          ManagedUnit?               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  garage        ManagedGarage?             @relation(fields: [garageId], references: [id], onDelete: SetNull)
  plan          PreventiveMaintenancePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  vendor        ManagedVendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  documents     ManagedDocument[]
  managedPhotos ManagedPhoto[]

  @@index([propertyId])
  @@index([unitId, dueAt])
  @@index([garageId, dueAt])
  @@index([planId])
  @@index([status])
  @@index([vendorId])
}

model UnitAccessCode {
  id             String         @id @default(cuid())
  propertyId     String
  unitId         String?
  garageId       String?
  accessType     UnitAccessType @default(ApartmentDoor)
  label          String
  codeCiphertext String
  codeLast4      String?
  isActive       Boolean        @default(true)
  effectiveFrom  DateTime       @default(now())
  effectiveTo    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  property ManagedProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     ManagedUnit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  garage   ManagedGarage?  @relation(fields: [garageId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([unitId, isActive])
  @@index([garageId, isActive])
}

model UnitKey {
  id           String    @id @default(cuid())
  propertyId   String
  unitId       String?
  garageId     String?
  keyLabel     String
  keyType      String
  serialNumber String?
  assignedTo   String?
  issuedAt     DateTime?
  returnedAt   DateTime?
  isActive     Boolean   @default(true)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  property ManagedProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     ManagedUnit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  garage   ManagedGarage?  @relation(fields: [garageId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([unitId, isActive])
  @@index([garageId, isActive])
}

model ManagedDocument {
  id               String                  @id @default(cuid())
  propertyId       String
  unitId           String?
  garageId         String?
  repairEventId    String?
  maintenanceRunId String?
  name             String
  originalFileName String?
  mimeType         String
  category         ManagedDocumentCategory @default(Other)
  summary          String?
  storageKey       String
  fileSizeBytes    Int?
  uploadedAt       DateTime                @default(now())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  property       ManagedProperty           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit           ManagedUnit?              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  garage         ManagedGarage?            @relation(fields: [garageId], references: [id], onDelete: SetNull)
  repairEvent    UnitRepairEvent?          @relation(fields: [repairEventId], references: [id], onDelete: SetNull)
  maintenanceRun PreventiveMaintenanceRun? @relation(fields: [maintenanceRunId], references: [id], onDelete: SetNull)

  @@index([propertyId, category])
  @@index([unitId, uploadedAt])
  @@index([garageId, uploadedAt])
  @@index([repairEventId])
  @@index([maintenanceRunId])
}

model UnitNote {
  id         String   @id @default(cuid())
  propertyId String
  unitId     String
  title      String?
  body       String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property ManagedProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     ManagedUnit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([unitId, createdAt])
  @@index([unitId, pinned])
}

model ManagedAuditLog {
  id          String   @id @default(cuid())
  propertyId  String?
  actorUserId String?
  entityType  String
  entityId    String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  property  ManagedProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  actorUser User?            @relation("ManagedAuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([actorUserId, createdAt])
}
